function cleanUrl(raw: string) {
  // Bunny accetta spazi codificati: li sistemiamo noi se si incolla un link "grezzo"
  return raw.trim().replace(/ /g, '%20');
}

function readPw() {
  try {
    return sessionStorage.getItem(PW_KEY) || '';
