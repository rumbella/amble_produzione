rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // User Entity Validation
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'likes']) &&
             data.email is string && data.email.size() <= 256 &&
             data.likes is list && data.likes.size() <= 1000;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming());

      allow update: if isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming()) && (
                      incoming().diff(existing()).affectedKeys().hasOnly(['likes']) ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'likes']) ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'createdAt', 'likes'])
                    );
    }
  }
}
